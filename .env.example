# ============================================================
#  .env.example — copy this to .env and fill in your values
#  NEVER commit your real .env to version control!
# ============================================================

# ── NewsAPI (https://newsapi.org/register — free) ───────────
NEWSAPI_KEY=your_newsapi_key_here

# ── MongoDB ─────────────────────────────────────────────────
# Local MongoDB:
MONGO_URI=mongodb://localhost:27017/fakenews
# MongoDB Atlas:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/fakenews

# ── Admin Dashboard ─────────────────────────────────────────
ADMIN_PASSWORD=admin123

# ── Safety Threshold ─────────────────────────────────────────
# New model replaces old only if accuracy >= (prev - MIN_ACCURACY_DELTA)
# -0.02 means new model can be at most 2% worse than old one
MIN_ACCURACY_DELTA=-0.02

# ── Scheduler ───────────────────────────────────────────────
FETCH_HOUR=7               # daily news fetch at 07:00 UTC
RETRAIN_DAY_OF_WEEK=mon    # weekly retrain on Monday
RETRAIN_HOUR=2             # at 02:00 UTC

# ── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
