# ============================================================
#  Fake News Detector — Environment Configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control!
# ============================================================

# ── NewsAPI (https://newsapi.org) ───────────────────────────
NEWSAPI_KEY=5af8d5606aa54e1d89ba650fc3147a0b

# ── MongoDB ─────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/fakenews
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/fakenews
MONGO_URI=mongodb://localhost:27017/fakenews

# ── Admin Dashboard ─────────────────────────────────────────
ADMIN_PASSWORD=admin123

# ── Retraining Safety Threshold ─────────────────────────────
# New model replaces old only if accuracy >= (old_accuracy + MIN_ACCURACY_DELTA)
MIN_ACCURACY_DELTA=-0.02

# ── Scheduler Settings ──────────────────────────────────────
# Daily news fetch time (24h, UTC)
FETCH_HOUR=7

# Weekly retrain schedule
RETRAIN_DAY_OF_WEEK=mon
RETRAIN_HOUR=2

# ── Flask ───────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key
